{"nodes": [{"id": "readme_arcsonare", "label": "ArcSonare", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:1-7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Voice-first AI operating environment for Windows; Phase 3 evolves it from a settings-only utility into a full desktop Command Center."}, {"id": "readme_command_center", "label": "Command Center (main window)", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:3-7,18", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single main native window hosting Dashboard, Tasks, Agent, Connect and Settings pages; Settings is a page inside main rather than a separate window so all entry points (header gear, tray, quick menu) navigate to one surface."}, {"id": "readme_sonare_overlay", "label": "sonare-overlay (top-edge voice capsule)", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:19", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_sonare_quick_menu", "label": "sonare-quick-menu (tray popover)", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:20", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_global_shortcut_routing", "label": "Global Shortcut Routing", "file_type": "rationale", "source_file": "README.md", "source_location": "README.md:30-35", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When the main window is visible AND focused, the global shortcut toggles the in-app voice console via the sonare:voice-toggle event; otherwise it toggles the top-screen overlay. This keeps one shortcut serving two surfaces without conflict."}, {"id": "readme_show_hide_window_pattern", "label": "Show/Hide-Never-Destroy Window Pattern", "file_type": "rationale", "source_file": "README.md", "source_location": "README.md:26-28", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Windows are only ever shown/hidden, never destroyed; closing the main window (red traffic light, Alt+F4) hides ArcSonare to the tray, and only 'Quit ArcSonare' exits. Preserves window state and enables instant re-show."}, {"id": "readme_voice_simulation", "label": "Simulated Voice States", "file_type": "rationale", "source_file": "README.md", "source_location": "README.md:9-12,65", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No real microphone, AI model, or OAuth integration is connected in Phase 3; voice states (listening -> processing -> speaking) are a clearly-local simulation and integrations honestly show 'Not connected / Coming soon' to avoid implying capability that does not exist."}, {"id": "readme_rust_native_layer", "label": "Rust Native Layer", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:39-42", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rust owns all native behavior: global shortcut (register-new-before-unregister-old ordering), settings persistence in %APPDATA%\\com.arcsonare.desktop, autostart, monitor-aware positioning, tray, and window show/hide commands in panels.rs."}, {"id": "readme_react_frontend", "label": "React + TypeScript Frontend", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:43-46", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "React + TypeScript renders the four windows routed by window label in App.tsx; main-window state lives in small useSyncExternalStore stores under src/stores/."}, {"id": "readme_voicestore", "label": "voiceStore (shared voice states)", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:45", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_taskstore", "label": "taskStore (persisted tasks)", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:45-46", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_appstore", "label": "appStore (page, palette, activity log)", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:46", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_smoked_titanium_design", "label": "Smoked Titanium Design Language", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:47-48", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Design tokens in src/styles/tokens.css: graphite surfaces with a restrained violet AI accent, shared across all windows/surfaces for visual consistency."}, {"id": "readme_orbital_logo", "label": "Orbital ArcSonare Logo", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:48-50", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The orbital mark lives in src/components/brand/ArcSonareLogo.tsx and was the source from which the app icons in src-tauri/icons were generated."}, {"id": "readme_icon_registry", "label": "Icon Registry (iconRegistry.ts)", "file_type": "concept", "source_file": "README.md", "source_location": "README.md:51-53", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Icon mapping in src/config/iconRegistry.ts; integration logos were extracted from the local ICO/ library (highest-resolution PNG frame) into src/assets/icons/integrations/ and keep their brand colors. Asana and Microsoft Calendar are absent because the ICO library lacks those icons."}, {"id": "readme_demo_data", "label": "Demo Data (demoData.ts)", "file_type": "concept", "source_file": "README.md", "source_locat