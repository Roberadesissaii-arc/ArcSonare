{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ArcSonare",
  "version": "0.2.54",
  "identifier": "com.arcsonare.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ArcSonare",
        "url": "index.html",
        "width": 1600,
        "height": 920,
        "minWidth": 1280,
        "minHeight": 760,
        "visible": true,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "backgroundColor": "#05090C",
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "fullscreen": false,
        "center": true,
        "additionalBrowserArgs": "--use-fake-ui-for-media-stream --autoplay-policy=no-user-gesture-required"
      },
      {
        "label": "sonare-overlay",
        "title": "ArcSonare",
        "width": 600,
        "height": 70,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": true,
        "fullscreen": false,
        "shadow": false,
        "center": false,
        "focus": false,
        "additionalBrowserArgs": "--use-fake-ui-for-media-stream --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; media-src 'self' blob: http://127.0.0.1:8000 http://localhost:8000; style-src 'self' 'unsafe-inline'; connect-src 'self' https://api.openai.com https://generativelanguage.googleapis.com https://api.deepseek.com http://127.0.0.1:8000 http://localhost:8000 https://api.open-meteo.com https://api.bigdatacloud.net https://photon.komoot.io https://nominatim.openstreetmap.org https://router.project-osrm.org",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/backgrounds/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
