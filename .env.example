VITE_SUPABASE_URL=https://ocxsjvkejknvlilnqbsk.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Google (Gmail, Calendar, Drive, Docs, Sheets)
# Create an OAuth 2.0 Client ID in Google Cloud Console, then restart the app.
# https://console.cloud.google.com/apis/credentials
#
# Required Authorized redirect URI (exact):
#   http://127.0.0.1:8765/oauth/google
#
# Prefer OAuth client type "Desktop app" (PKCE, no secret).
# If you use "Web application", also paste the Client Secret in
# Settings → Integrations (stored in Windows Credential Manager).
#
# Consent screen in Testing? Add every Gmail under Test users — the Client ID
# is the app identity; it is NOT locked to one mailbox.
VITE_GOOGLE_OAUTH_CLIENT_ID=

