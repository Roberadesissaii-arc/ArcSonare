# ArcSonare — build-time configuration
#
# Copy this file to `.env` and fill in what you want baked into the build.
# `.env` is gitignored and never committed.
#
#   copy .env.example .env
#   npm run tauri:build
#
# ---------------------------------------------------------------------------
# READ THIS BEFORE PUTTING REAL KEYS HERE
# ---------------------------------------------------------------------------
# Keys set here are compiled into the installer. A desktop app runs on someone
# else's computer, so anyone holding the .exe can extract them. That is true of
# every desktop app — it is not a flaw in how this is wired.
#
#   * Installing on your own machines        -> fine.
#   * Sharing the installer with other people -> they can spend on YOUR quota
#     and YOUR bill. Leave these blank instead and let each person add their
#     own key in Settings.
#
# On first launch each key set here is copied into Windows Credential Manager
# and read from there afterwards. A key saved in Settings always wins: this
# only ever fills an empty slot, it never overwrites someone's own key.
# ---------------------------------------------------------------------------


# --- AI providers -----------------------------------------------------------

# OpenAI — REQUIRED FOR VOICE (the Realtime speech-to-speech overlay).
# Without this the overlay cannot talk. Also powers GPT chat models.
#   https://platform.openai.com/api-keys
ARCSONARE_OPENAI_API_KEY=

# DeepSeek — chat and tool calling. A good default everyday assistant.
#   https://platform.deepseek.com/api_keys
ARCSONARE_DEEPSEEK_API_KEY=

# Google Gemini — chat, plus VISION: screen understanding and "click the X on
# screen". Also used by `npm run voice:generate` for the built-in voice clips.
#   https://aistudio.google.com/apikey
ARCSONARE_GEMINI_API_KEY=


# --- Google sign-in (Gmail / Calendar / Drive) ------------------------------
# Only needed for the Google integrations. This is an OAuth *client id*, not a
# secret — it identifies the app, not a user.
#
# Create an OAuth 2.0 Client ID (type: "Desktop app") at
#   https://console.cloud.google.com/apis/credentials
#
# Authorized redirect URI, exactly:
#   http://127.0.0.1:8765/oauth/google
#
# If the consent screen is in "Testing", add each Gmail address under
# Test users — the client id is the app identity, not one mailbox.
VITE_GOOGLE_OAUTH_CLIENT_ID=
